<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.localsoul</groupId>
    <artifactId>recomp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>port-cli</artifactId>
  <name>port-cli</name>
  <description>Headless CLI port (docs/modules/port-cli.md, docs/cli-contract.md)</description>

  <dependencies>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>ir</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>generator-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>frontend-unity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>launcher-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>index</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.tomlj</groupId>
      <artifactId>tomlj</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.localsoul</groupId>
      <artifactId>launcher-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- sqlite-jdbc lädt eine native Bibliothek (Java 25 warnt sonst auf stderr). -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>port-cli nutzt Adapter und Engine nie als Code, nur über Dateien (docs/modules/port-cli.md).</message>
                  <excludes>
                    <exclude>io.github.localsoul:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.github.localsoul:ir</include>
                    <include>io.github.localsoul:generator-java</include>
                    <include>io.github.localsoul:frontend-unity</include>
                    <include>io.github.localsoul:launcher-core</include>
                    <include>io.github.localsoul:index</include>
                    <!-- nur Metadaten (EngineApiVersion), über launcher-core -->
                    <include>io.github.localsoul:engine-api</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
