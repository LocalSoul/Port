(ir :version 1 :assembly "Assembly-CSharp")

(class Holder :base UnityEngine.MonoBehaviour :mods (public)
  (field Instances i32 :mods (public static))
  (field health f32 :mods (private) :attrs ((UnityEngine.SerializeField)) :init 100.0f32)
  (field level i32 :mods (private))
  (prop Health f32 :mods (public)
    :get (block
      (return (field this Holder::health))))
  (prop Level i32 :mods (public)
    :get (block
      (return (field this Holder::level)))
    :set (block
      (expr
        (set (field this Holder::level)
          (scall UnityEngine.Mathf::Clamp#i32,i32,i32 value 0i32 10i32)))))
  (method Awake void () :mods (private)
    (block
      (expr (post-inc (sfield Holder::Instances))))))
