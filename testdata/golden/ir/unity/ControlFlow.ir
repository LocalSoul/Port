(ir :version 1 :assembly "Assembly-CSharp")

(class ControlFlow :mods (public)
  (method Average f32 ((values f32[])) :mods (public)
    (block
      (if (== (prop values System.Array::Length) 0i32)
        (block
          (return 0.0f32)))
      (local total f32 0.0f32)
      (for ((local i i32 0i32)) (< i (prop values System.Array::Length)) ((post-inc i))
        (block
          (expr (set-op + total (index values i)))))
      (return (/ total (conv f32 (prop values System.Array::Length))))))
  (method CountDown i32 ((start i32)) :mods (public)
    (block
      (local steps i32 0i32)
      (while (> start 0i32)
        (block
          (expr (post-dec start))
          (expr (post-inc steps))
          (if (> steps 100i32)
            (block
              (break)))))
      (return steps)))
  (method Describe string ((code i32)) :mods (public)
    (block
      (switch code
        (case (0i32) (return "null"))
        (case (1i32 2i32) (return "klein"))
        (default (return "groß")))))
  (method Score i32 ((grade string)) :mods (public)
    (block
      (if (not (scall System.String::op_Equality#string,string grade "A"))
        (block
          (if (scall System.String::op_Equality#string,string grade "B")
            (block
              (return 2i32)))
          (return 0i32)))
      (return 3i32)))
  (method Sum i32 ((values i32[])) :mods (public)
    (block
      (local sum i32 0i32)
      (foreach v i32 values
        (block
          (if (>= v 0i32)
            (block
              (expr (set-op + sum v))))))
      (return sum))))
