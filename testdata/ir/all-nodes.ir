; Synthetische Fixture: jede Knotenart aus docs/ir-spec.md Abschnitte 5 bis 7 und 9 mindestens einmal.
; Mitglieder stehen absichtlich nicht in kanonischer Reihenfolge.
(ir :version 1 :assembly "Fixture.AllNodes" :sha256 "00ff" :note "Kopf")

(interface Demo.IShape :generics (T) :mods (public)
  (method Area f64 () :mods (public abstract) :abstract)
  (prop Name string :mods (public)))

(enum Demo.Color :underlying i32 :loc "Color.cs:1"
  (Red 0i32)
  (Green 1i32 :note "Grün")
  (Blue 0x2i32))

(struct Demo.Point :implements (Demo.IShape<f32>)
  (method Area f64 () :mods (public)
    (return (conv f64 (* (field this Demo.Point::x) (field this Demo.Point::y)))))
  (field y f32 :mods (public))
  (field x f32 :mods (public))
  (prop Name string :mods (public) :get (return "Punkt")))

(class Demo.Player :base UnityEngine.MonoBehaviour :mods (public sealed)
    :attrs ((UnityEngine.RequireComponent (typeof UnityEngine.Rigidbody)))
  (method Update void () :mods (private)
    (block
      (local dt f32 (sprop UnityEngine.Time::deltaTime))
      (local text string)
      (local i i32 0i32 :loc "Player.cs:20")
      (expr (set text (scall System.String::Concat#string,string "a\tb\n" "ä\"\\")))
      (if (&& (> dt 0.0f32) (not (== text null)))
        (block
          (expr (set-op + i 1i32))
          (expr (post-inc i)))
        (block
          (expr (pre-dec i))))
      (while (< i 10i32)
        (block
          (if (== (% i 2i32) 0i32) (continue))
          (expr (set i (+ i 1i32)))))
      (do-while (block (break)) false)
      (for ((local k i32 0i32)) (< k 3i32) ((post-inc k) (pre-inc i)) (block))
      (foreach item Demo.Point (field this Demo.Player::points)
        (expr (call item Demo.Point::Area#)))
      (switch i
        (case (0i32 1i32) (return))
        (case (2i32) (expr (pre-inc i)) (break))
        (default (throw (new System.InvalidOperationException::.ctor#string "x"))))
      (try
        (block (expr (scall Demo.Player::Risky#)))
        (catch e System.Exception (block (throw e)))
        (finally (block)))
      (lock this (block))
      (using r System.IO.Stream (scall System.IO.File::OpenRead#string "f") (block))
      (label again)
      (goto again)
      (raw cs "x ??= y;")
      (manual "noch offen" :note "später")))
  (field speed f32 :mods (public) :attrs ((UnityEngine.SerializeField)) :init 5.0f32)
  (field points Demo.Point[] :mods (private) :init (new-array Demo.Point 4i32))
  (field grid f32[,] :mods (private) :init (new-array f32 2i32 2i32))
  (field primes i32[] :mods (private static readonly) :init (array-lit i32 2i32 3i32 5i32))
  (field letter char :init (char 65))
  (field big u64 :mods (const) :init 0xFFFFFFFFFFFFFFFFu64)
  (field small i8 :init -128i8)
  (field ratio f64 :init 1.5e-3f64)
  (event Died System.Action :mods (public))
  (ctor () :mods (public) :base-call () (block (expr (set (field this Demo.Player::speed) 1.0f32))))
  (ctor () :mods (static) (block))
  (ctor ((s f32) (name string :default null)) :mods (public)
    (block (expr (set (field base Demo.Player::speed) s))))
  (prop Health i32 :mods (public)
    :get (return (cond (is Demo.Player this p) 100i32 0i32))
    :set (block (expr (set (sfield Demo.Player::last) value))))
  (method Iterate System.Collections.IEnumerator () :mods (private)
    (block (yield-return null) (yield-break)))
  (method Swap void ((a T :ref) (b T :ref)) :mods (public static) :generics (T)
    (block
      (local t T a)
      (expr (set a b))
      (expr (set b t))))
  (method TryGet bool ((key string) (value i32 :out) (opt Demo.Point :in)) :mods (public)
    (block (expr (set value (default i32))) (return true)))
  (method Misc void () :mods (private) :manual "Handarbeit"
    (block
      (local o object (as System.Object (cast Demo.Player this)))
      (local n i32? (coalesce (unchecked (checked (+ 1i32 2i32))) 0i32))
      (local arr i32[] (array-lit i32))
      (expr (set (index arr 0i32) (neg (index arr 1i32))))
      (expr (set (sprop Demo.Player::Shared) (bnot 1u32)))
      (local f System.Func<i32,i32> (lambda ((x i32)) (return (<< x 1i32))))
      (local d System.Action (delegate this Demo.Player::Update#))
      (expr (event-add this Demo.Player::Died d))
      (expr (event-remove this Demo.Player::Died d))
      (local copyOf Demo.Point (copy (default Demo.Point)))
      (local typ System.Type (typeof Demo.Point))
      (local any object (raw cs "dynamic stuff"))
      (local later object (manual "Ausdruck fehlt"))
      (expr (prop (cast Demo.IShape<f32> copyOf) Demo.IShape::Name)))))
